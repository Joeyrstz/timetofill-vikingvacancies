---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Calculator from "../components/Calculator.astro";
import Trust from "../components/Trust.astro";
import Benchmarks from "../components/Benchmarks.astro";
import Notes from "../components/Notes.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { FAQ } from "../scripts/content";

const title = "Time-to-Fill-Rechner: Was kostet eure unbesetzte Stelle? | VikingVacancies";
const description =
  "Berechnet, was euch eine offene Tech-Stelle wirklich kostet — und ab wann sich eine schnellere Festbesetzung rechnet. Offengelegte Formel, Richtwerte für NRW, keine Datenübertragung.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Calculator />
    <Trust />
    <Benchmarks />
    <Notes />
    <Faq />
    <Cta />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>
