---
const links = [
  { label: "Für Kandidaten", href: "https://www.viking-vacancies.de/kandidaten" },
  { label: "Für Unternehmen", href: "https://www.viking-vacancies.de/unternehmen" },
  { label: "Für HR & Partner", href: "https://www.viking-vacancies.de/hr-partner" },
  { label: "Time-to-Fill", href: "#rechner", current: true },
];
---

<header class="header">
  <div class="header__bar">
    <a class="brand" href="https://www.viking-vacancies.de/">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.45" />
        <path d="M16 4v24M4 16h24" stroke="currentColor" stroke-width="1" opacity="0.3" />
        <path d="M16 5.5 19.4 16 16 26.5 12.6 16Z" fill="currentColor" />
      </svg>
      <span class="brand__name">Viking<strong>Vacancies</strong></span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      {
        links.map((link) => (
          <a
            class:list={["nav__link", link.current && "nav__link--current"]}
            href={link.href}
            aria-current={link.current ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="btn header__cta" href="https://www.viking-vacancies.de/contact">Kontakt</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.85rem var(--vv-gutter);
    /* Bewusst ohne eigenen Hintergrund: die Pille schwebt über hellen wie
       dunklen Sektionen, so wie auf viking-vacancies.de. Ein Verlauf würde
       über den weißen Abschnitten als dunkler Schmutzrand sichtbar. */
    background: transparent;
    pointer-events: none;
  }

  .header__bar {
    pointer-events: auto;
  }

  .header__bar {
    max-width: var(--vv-shell);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--vv-pill);
    background: rgba(23, 30, 40, 0.88);
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 28px rgba(23, 30, 40, 0.18);
    color: #fff;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #fff;
    flex: none;
  }

  .brand__mark {
    width: 26px;
    height: 26px;
    color: var(--vv-amber);
  }

  .brand__name {
    font-size: 0.98rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .brand__name strong {
    font-weight: 600;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-left: auto;
  }

  .nav__link {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav__link:hover {
    color: #fff;
  }

  .nav__link--current {
    color: var(--vv-amber);
  }

  .header__cta {
    flex: none;
    padding: 0.65rem 1.5rem;
    font-size: 0.86rem;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .header__bar {
      justify-content: space-between;
    }

    .header__cta {
      margin-left: auto;
    }
  }
</style>
